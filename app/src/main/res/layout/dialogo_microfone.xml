<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <RadioGroup
            android:id="@+id/grupoMicrofones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/RotuloOpcao"
            android:text="@string/microfone_volume" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/medidorTeste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            app:indicatorColor="@color/laranja"
            app:trackCornerRadius="4dp"
            app:trackThickness="10dp" />

        <TextView
            android:id="@+id/captandoPor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/microfone_dica"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizCamera"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".CameraActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previa"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Caixa de texto sobre a câmera. A posição (topo, centro, base ou livre), o fundo e os cantos
        são ajustados no código; na posição livre, a alça no topo arrasta a caixa.
    -->
    <LinearLayout
        android:id="@+id/caixaTextoCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/alcaArrastar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:contentDescription="@string/arrastar_texto"
            android:visibility="gone">

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="@drawable/fundo_alca" />
        </FrameLayout>

    <ScrollView
        android:id="@+id/rolagemCamera"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/textoCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="1.2"
            android:paddingHorizontal="16dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="4"
            android:textColor="@color/white"
            android:textSize="24sp" />
    </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/semPermissao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permissao_camera_negada"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/botaoPermissao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/permissao_conceder" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/barraCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoVoltarCamera"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/voltar"
            app:icon="@drawable/ic_back"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoTrocarCamera"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/trocar_camera"
            app:icon="@drawable/ic_switch_camera"
            app:iconTint="@color/white" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/botaoGravar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/fundo_gravar"
            android:contentDescription="@string/gravar_video" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoReiniciarCamera"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/reiniciar"
            app:icon="@drawable/ic_replay"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoPlayCamera"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/play"
            app:icon="@drawable/ic_play"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoConfigCamera"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/configuracoes"
            app:icon="@drawable/ic_tune"
            app:iconTint="@color/white" />
    </LinearLayout>

    <!-- Microfone em uso (toque para trocar/testar); durante a gravação mostra volume e tempo -->
    <LinearLayout
        android:id="@+id/pilulaMicrofone"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:background="@drawable/fundo_pilula_microfone"
        android:clickable="true"
        android:contentDescription="@string/escolher_microfone"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mic"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/nomeMicrofone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/medidorVolume"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:max="100"
            android:visibility="gone"
            app:indicatorColor="@color/laranja"
            app:trackColor="#4DFFFFFF"
            app:trackCornerRadius="2dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/tempoGravacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:drawablePadding="4dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/gravando"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Aviso rápido (ex.: velocidade alterada pelo controle remoto) -->
    <TextView
        android:id="@+id/indicador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/fundo_indicador"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/white"
        android:visibility="gone" />
</FrameLayout>

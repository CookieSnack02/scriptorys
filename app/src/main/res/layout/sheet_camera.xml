<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/RotuloOpcao"
            android:text="@string/posicao_texto" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupoPosicao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/posicaoTopo"
                style="@style/BotaoOpcao"
                android:text="@string/topo" />

            <Button
                android:id="@+id/posicaoCentro"
                style="@style/BotaoOpcao"
                android:text="@string/centro" />

            <Button
                android:id="@+id/posicaoBase"
                style="@style/BotaoOpcao"
                android:text="@string/base" />

            <Button
                android:id="@+id/posicaoLivre"
                style="@style/BotaoOpcao"
                android:text="@string/livre" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Cola a caixa na câmera frontal embutida na tela (como num teleprompter de verdade) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoSobreCamera"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sobre_camera"
            app:icon="@drawable/ic_videocam" />

        <!-- Só na posição livre: largura da caixa (menor que a tela, para poder mover para os lados) -->
        <LinearLayout
            android:id="@+id/opcoesLivre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dica_livre"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <TextView
                android:id="@+id/rotuloLarguraCamera"
                style="@style/RotuloOpcao" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderLarguraCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:valueFrom="40"
                android:valueTo="100"
                app:tickVisible="false" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/interruptorArredondado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cantos_arredondados"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:id="@+id/rotuloTamanhoCamera"
            style="@style/RotuloOpcao" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderTamanhoCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="2"
            android:valueFrom="14"
            android:valueTo="64"
            app:tickVisible="false" />

        <TextView
            style="@style/RotuloOpcao"
            android:text="@string/cor_do_texto" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoCorCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/rotuloVelocidadeCamera"
            style="@style/RotuloOpcao" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderVelocidadeCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="300"
            app:tickVisible="false" />

        <TextView
            style="@style/RotuloOpcao"
            android:text="@string/salvar_videos_em" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoPastaVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

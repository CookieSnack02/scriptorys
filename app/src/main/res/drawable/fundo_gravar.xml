<?xml version="1.0" encoding="utf-8"?>
<!-- Botão de gravar parado: anel branco com círculo vermelho -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="@color/white" />
        </shape>
    </item>
    <item android:bottom="7dp" android:left="7dp" android:right="7dp" android:top="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/gravando" />
        </shape>
    </item>
</layer-list>
